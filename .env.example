# Copy to `.env` and fill in. Only the provider selected in skb/config.json needs a key.
# The .env file is git-ignored; this .example is the tracked template.

# OpenRouter (default provider)
OPENROUTER_API_KEY=sk-or-...

# Google Gemini (direct, OpenAI-compatible endpoint)
GEMINI_API_KEY=

# Ollama (local) — any non-empty value works; no real key needed
OLLAMA_API_KEY=ollama

# web_search built-in tool (optional) — set one or both; Tavily is preferred when both
# are present, WEB_SEARCH_PROVIDER=tavily|exa forces one. No key = tool disabled.
TAVILY_API_KEY=
EXA_API_KEY=

# read_url built-in tool (Jina Reader) — works WITHOUT a key (free tier); an optional
# key only raises the rate limits.
JINA_API_KEY=
